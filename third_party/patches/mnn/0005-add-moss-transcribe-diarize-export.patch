+class MossAudioEncoderFront(torch.nn.Module):
+    def __init__(self, encoder):
+        super().__init__()
+        self.encoder = encoder
+
+    def forward(self, input_features):
+        input_features = input_features.to(
+            dtype=self.encoder.conv1.weight.dtype,
+            device=self.encoder.conv1.weight.device,
+        )
+        hidden_states = torch.nn.functional.gelu(self.encoder.conv1(input_features))
+        hidden_states = torch.nn.functional.gelu(self.encoder.conv2(hidden_states))
+        hidden_states = hidden_states.permute(0, 2, 1)
+        hidden_states = hidden_states + self.encoder.embed_positions.weight
+        for layer in self.encoder.layers[:12]:
+            hidden_states = layer(hidden_states, None)
+        return hidden_states
+
+
+class MossAudioEncoderBack(torch.nn.Module):
+    def __init__(self, encoder, adaptor, merge_size):
+        super().__init__()
+        self.layers = torch.nn.ModuleList(encoder.layers[12:])
+        self.layer_norm = encoder.layer_norm
+        self.adaptor = adaptor
+        self.merge_size = int(merge_size)
+
+    def forward(self, hidden_states):
+        for layer in self.layers:
+            hidden_states = layer(hidden_states, None)
+        hidden_states = self.layer_norm(hidden_states)
+        batch, frames, width = hidden_states.shape
+        trimmed = (frames // self.merge_size) * self.merge_size
+        hidden_states = hidden_states[:, :trimmed, :].reshape(
+            batch, trimmed // self.merge_size, width * self.merge_size
+        )
+        return self.adaptor(hidden_states)
+
+
+class MossTranscribeDiarizeAudio(Audio):
+    """Fixed-shape Whisper-Medium + 4x merge + VQAdaptor export."""
+    def __init__(self, audio, base):
+        super().__init__(audio, base)
+        self.audio_embeds = None
+        self.audio_pad_id = 151671
+        self.n_fft = 400
+        self.sampling_rate = 16000
+        self.hop_length = 160
+        self.chunk_length = 30
+        self.feature_size = 80
+        self.n_samples = self.chunk_length * self.sampling_rate
+        self.max_length = self.n_samples // self.hop_length
+        from transformers.audio_utils import mel_filter_bank
+        self.mel_filters = mel_filter_bank(
+            num_frequency_bins=1 + self.n_fft // 2,
+            num_mel_filters=self.feature_size,
+            min_frequency=0.0,
+            max_frequency=8000.0,
+            sampling_rate=self.sampling_rate,
+            norm="slaney",
+            mel_scale="slaney",
+        )
+
+    def load(self):
+        self.audio_tower = self.audio.whisper_encoder
+        self.vq_adaptor = self.audio.vq_adaptor
+        merge_size = int(self.config.audio_merge_size)
+        self.front = MossAudioEncoderFront(self.audio_tower)
+        self.back = MossAudioEncoderBack(self.audio_tower, self.vq_adaptor, merge_size)
+        self.llm_config.update({
+            'is_audio': True,
+            'audio_type': 'moss_transcribe_diarize',
+            'audio_pad': int(self.config.audio_token_id),
+            'audio_start': int(self.tokenizer.convert_tokens_to_ids('<|audio_start|>')),
+            'audio_end': int(self.tokenizer.convert_tokens_to_ids('<|audio_end|>')),
+            'audio_merge_size': merge_size,
+            'audio_tokens_per_second': 12.5,
+            # Pinned processor_config.json uses five-second time anchors.
+            'time_marker_every_seconds': 5,
+            'audio_front_model': 'audio_encoder_front.mnn',
+            'audio_back_model': 'audio_encoder_back.mnn',
+        })
+
+    def forward(self, input_features):
+        return self.back(self.front(input_features))
+
+    def _torch_extract_fbank_features(self, waveform):
+        window = torch.hann_window(self.n_fft)
+        stft = torch.stft(
+            waveform, self.n_fft, self.hop_length, window=window, return_complex=True
+        )
+        magnitudes = stft[..., :-1].abs() ** 2
+        mel_filters = torch.from_numpy(self.mel_filters).type(torch.float32)
+        mel_spec = mel_filters.T @ magnitudes
+        log_spec = torch.clamp(mel_spec, min=1e-10).log10()
+        log_spec = torch.maximum(log_spec, log_spec.max() - 8.0)
+        return (log_spec + 4.0) / 4.0
+
+    def audio_process(self, audio_obj):
+        if audio_obj.size == 0:
+            raise ValueError("MOSS audio must contain at least one sample")
+        if audio_obj.size > 300 * self.sampling_rate:
+            raise ValueError("MOSS QNN PoC supports at most 300 seconds")
+        outputs = []
+        for start in range(0, audio_obj.size, self.n_samples):
+            chunk = audio_obj[start:start + self.n_samples]
+            valid_tokens = (chunk.size - 1) // 1280 + 1
+            if chunk.size < self.n_samples:
+                chunk = torch.nn.functional.pad(
+                    torch.from_numpy(chunk).float(), (0, self.n_samples - chunk.size)
+                )
+            else:
+                chunk = torch.from_numpy(chunk).float()
+            features = self._torch_extract_fbank_features(chunk).unsqueeze(0)
+            outputs.append(self.forward(features)[:, :valid_tokens, :])
+        audio_embeds = torch.cat(outputs, dim=1)
+        self.audio_embeds = audio_embeds.permute(1, 0, 2)
+        return self.audio_embeds.shape[0]
+
+    def embed(self, input_ids, images=None, videos=None):
+        input_embeds = self.embed_(input_ids)
+        if self.audio_embeds is not None:
+            audio_mask = (input_ids == self.audio_pad_id).squeeze()
+            input_embeds[audio_mask] = self.audio_embeds.type(input_embeds.dtype)
+        return input_embeds
+
+    @spinner_run(f'export MOSS audio to ')
+    def export(self, onnx_path):
+        front_path = f'{onnx_path}/audio_encoder_front.onnx'
+        back_path = f'{onnx_path}/audio_encoder_back.onnx'
+        onnx_export(
+            self.front.float(), torch.randn((1, 80, 3000)), front_path,
+            input_names=['input_features'], output_names=['hidden_states'],
+        )
+        onnx_export(
+            self.back.float(), torch.randn((1, 1500, 1024)), back_path,
+            input_names=['hidden_states'], output_names=['audio_embeds'],
+        )
+        return [front_path, back_path]
+
