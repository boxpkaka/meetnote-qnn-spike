diff --git a/transformers/llm/engine/demo/moss_qnn_runner.cpp b/transformers/llm/engine/demo/moss_qnn_runner.cpp
new file mode 100644
index 0000000..fa53d10
--- /dev/null
+++ b/transformers/llm/engine/demo/moss_qnn_runner.cpp
@@ -0,0 +1,149 @@
+#include <atomic>
+#include <chrono>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <memory>
+#include <regex>
+#include <sstream>
+#include <string>
+#include <thread>
+
+#include <llm/llm.hpp>
+
+using MNN::Transformer::Llm;
+using MNN::Transformer::LlmStatus;
+using MNN::Transformer::MultimodalPrompt;
+using MNN::Transformer::PromptAudioPart;
+
+namespace {
+
+const char* kDefaultPrompt =
+    "请将音频转写为文本，每一段需以起始时间戳和说话人编号"
+    "（[S01]、[S02]、[S03]…）开头，正文为对应的语音内容，"
+    "并在段末标注结束时间戳，以清晰标明该段语音范围。";
+
+std::string jsonEscape(const std::string& source) {
+    std::ostringstream output;
+    for (unsigned char ch : source) {
+        switch (ch) {
+            case '\\': output << "\\\\"; break;
+            case '"': output << "\\\""; break;
+            case '\n': output << "\\n"; break;
+            case '\r': output << "\\r"; break;
+            case '\t': output << "\\t"; break;
+            default:
+                if (ch < 0x20) {
+                    const char* hex = "0123456789abcdef";
+                    output << "\\u00" << hex[ch >> 4] << hex[ch & 15];
+                } else {
+                    output << ch;
+                }
+        }
+    }
+    return output.str();
+}
+
+int64_t currentPssBytes() {
+    std::ifstream stream("/proc/self/smaps_rollup");
+    std::string key;
+    int64_t value = 0;
+    std::string unit;
+    while (stream >> key >> value >> unit) {
+        if (key == "Pss:") return value * 1024;
+        stream.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
+    }
+    return 0;
+}
+
+void writeSegments(std::ostream& output, const std::string& raw, bool* parsed) {
+    static const std::regex segment(
+        R"(\[([0-9]+(?:\.[0-9]+)?)\]\[(S[0-9]+)\]([\s\S]*?)\[([0-9]+(?:\.[0-9]+)?)\])");
+    bool first = true;
+    output << '[';
+    for (std::sregex_iterator it(raw.begin(), raw.end(), segment), end; it != end; ++it) {
+        double start = std::stod((*it)[1].str());
+        double finish = std::stod((*it)[4].str());
+        if (finish < start || (*it)[3].str().empty()) continue;
+        if (!first) output << ',';
+        first = false;
+        *parsed = true;
+        output << "{\"start\":" << start << ",\"end\":" << finish
+               << ",\"speaker\":\"" << (*it)[2].str() << "\",\"text\":\""
+               << jsonEscape((*it)[3].str()) << "\"}";
+    }
+    output << ']';
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 3 || argc > 4) {
+        std::cerr << "Usage: moss_qnn_runner config.json input.wav [hotwords]" << std::endl;
+        return 2;
+    }
+    std::ifstream wav(argv[2], std::ios::binary);
+    if (!wav.good()) {
+        std::cerr << "input WAV does not exist: " << argv[2] << std::endl;
+        return 2;
+    }
+    std::unique_ptr<Llm> llm(Llm::createLLM(argv[1]));
+    llm->set_config(
+        R"({"sampler_type":"greedy","max_all_tokens":8192,"max_new_tokens":4096,"async":false})");
+    if (!llm->load()) {
+        std::cout << "{\"format\":\"meetnote.moss_qnn_result.v1\",\"status\":\"error\","
+                     "\"errors\":[\"model_load_failed\"],\"raw_text\":\"\",\"segments\":[]}\n";
+        return 1;
+    }
+
+    MultimodalPrompt prompt;
+    prompt.prompt_template = "<audio>input</audio>\n" + std::string(kDefaultPrompt);
+    if (argc == 4 && argv[3][0] != '\0') prompt.prompt_template += "\n热词：" + std::string(argv[3]);
+    PromptAudioPart audio;
+    audio.file_path = argv[2];
+    prompt.audios["input"] = audio;
+
+    std::atomic<bool> monitoring(true);
+    std::atomic<int64_t> peakPss(currentPssBytes());
+    std::thread monitor([&]() {
+        while (monitoring.load()) {
+            auto current = currentPssBytes();
+            auto peak = peakPss.load();
+            while (current > peak && !peakPss.compare_exchange_weak(peak, current)) {}
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        }
+    });
+    auto started = std::chrono::steady_clock::now();
+    std::ostringstream raw;
+    llm->response(prompt, &raw, nullptr, 4096);
+    double totalMs = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - started).count();
+    monitoring.store(false);
+    monitor.join();
+
+    const auto* context = llm->getContext();
+    bool parsed = false;
+    bool budget = context->status == LlmStatus::MAX_TOKENS_FINISHED || context->gen_seq_len >= 4096;
+    bool runtimeError = context->status == LlmStatus::INTERNAL_ERROR || context->status == LlmStatus::TIMEOUT;
+    std::ostringstream result;
+    result << "{\"format\":\"meetnote.moss_qnn_result.v1\",\"status\":\"";
+    std::ostringstream segments;
+    writeSegments(segments, raw.str(), &parsed);
+    result << ((!parsed || budget || runtimeError) ? "error" : "ok") << "\",\"errors\":[";
+    bool comma = false;
+    if (!parsed) { result << "\"transcript_parse_failed\""; comma = true; }
+    if (budget) { if (comma) result << ','; result << "\"token_budget_exhausted\""; comma = true; }
+    if (runtimeError) { if (comma) result << ','; result << "\"runtime_error\""; }
+    result << "],\"raw_text\":\"" << jsonEscape(raw.str()) << "\",\"segments\":" << segments.str()
+           << ",\"generated_tokens\":" << context->gen_seq_len
+           << ",\"timings_ms\":{\"audio_encoder_front\":" << context->audio_front_us / 1000.0
+           << ",\"audio_encoder_back\":" << context->audio_back_us / 1000.0
+           << ",\"encoder\":" << context->audio_us / 1000.0
+           << ",\"prefill\":" << context->prefill_us / 1000.0
+           << ",\"decode\":" << context->decode_us / 1000.0
+           << ",\"total\":" << totalMs << "},\"rtf\":"
+           << (context->audio_input_s > 0 ? totalMs / 1000.0 / context->audio_input_s : 0.0)
+           << ",\"peak_pss_bytes\":" << peakPss.load() << "}";
+    std::cout << result.str() << std::endl;
+    return (!parsed || budget || runtimeError) ? 1 : 0;
+}
