+static bool _appendDebugOutputs(const Net* net, std::vector<SubModuleInfo>& submodules) {
+    for (const auto& tensorName : gDebugOutputNames) {
+        int tensorIndex = -1;
+        for (int index = 0; index < net->tensorName()->size(); ++index) {
+            if (net->tensorName()->GetAsString(index)->str() == tensorName) {
+                tensorIndex = index;
+                break;
+            }
+        }
+        if (tensorIndex < 0) {
+            MNN_ERROR("compilefornpu: debug output tensor not found: %s\n", tensorName.c_str());
+            return false;
+        }
+
+        bool appended = false;
+        for (auto& module : submodules) {
+            if (module.isBreak) {
+                continue;
+            }
+            bool producedByModule = false;
+            for (auto opIndex : module.opList) {
+                auto op = net->oplists()->GetAs<Op>(opIndex);
+                if (op->outputIndexes() == nullptr) {
+                    continue;
+                }
+                for (int output = 0; output < op->outputIndexes()->size(); ++output) {
+                    if (op->outputIndexes()->data()[output] == tensorIndex) {
+                        producedByModule = true;
+                        break;
+                    }
+                }
+                if (producedByModule) {
+                    break;
+                }
+            }
+            if (!producedByModule) {
+                continue;
+            }
+            if (std::find(module.outputs.begin(), module.outputs.end(), tensorIndex) ==
+                module.outputs.end()) {
+                // Append after normal outputs so existing plugin output positions stay stable.
+                module.outputs.emplace_back(tensorIndex);
+            }
+            MNN_PRINT(
+                "compilefornpu: expose debug output %s as t%d\n",
+                tensorName.c_str(),
+                tensorIndex);
+            appended = true;
+            break;
+        }
+        if (!appended) {
+            MNN_ERROR(
+                "compilefornpu: debug output is not produced by an NPU submodule: %s\n",
+                tensorName.c_str());
+            return false;
+        }
+    }
+    return true;
+}
