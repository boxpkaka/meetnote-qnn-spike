+static bool dumpMossAudioTensor(const char* prefix, int chunkIndex, const char* stage, VARP tensor) {
+    if (prefix == nullptr || prefix[0] == '\0') {
+        return true;
+    }
+    auto info = tensor == nullptr ? nullptr : tensor->getInfo();
+    auto values = tensor == nullptr ? nullptr : tensor->readMap<float>();
+    if (info == nullptr || values == nullptr) {
+        return false;
+    }
+    std::string path = std::string(prefix) + "-chunk" + std::to_string(chunkIndex) +
+        "-" + stage + ".f32";
+    std::ofstream output(path, std::ios::binary);
+    output.write(reinterpret_cast<const char*>(values), info->size * sizeof(float));
+    return output.good();
+}
