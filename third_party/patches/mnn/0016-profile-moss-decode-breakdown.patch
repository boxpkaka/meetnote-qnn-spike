+//
+//  LLMProfile.h
+//  MNN
+//
+//  Low-overhead profiling for heterogeneous LLM decode diagnostics.
+//
+
+#ifndef MNN_LLM_PROFILE_H
+#define MNN_LLM_PROFILE_H
+
+#include <cstddef>
+#include <cstdint>
+
+#include <MNN/MNNDefine.h>
+
+namespace MNN {
+
+enum class LLMProfileCategory : int {
+    CPUAttention = 0,
+    CPUAttentionKVUpdate = 1,
+    QNNInputCopy = 2,
+    QNNExecuteSync = 3,
+    QNNOutputCopy = 4,
+    QNNStateUpdate = 5,
+};
+
+struct LLMProfileBucket {
+    int32_t historyBegin = 0;
+    int32_t historyEnd = 0;
+    uint64_t cpuAttentionCalls = 0;
+    uint64_t cpuAttentionNs = 0;
+    uint64_t cpuAttentionKVUpdateNs = 0;
+    uint64_t qnnGraphCalls = 0;
+    uint64_t qnnInputCopyNs = 0;
+    uint64_t qnnExecuteSyncNs = 0;
+    uint64_t qnnOutputCopyNs = 0;
+    uint64_t qnnStateUpdateNs = 0;
+};
+
+MNN_PUBLIC void setLLMProfileEnabled(bool enabled);
+MNN_PUBLIC bool isLLMProfileEnabled();
+MNN_PUBLIC void resetLLMProfile();
+MNN_PUBLIC void recordLLMProfile(LLMProfileCategory category, int historyLength, uint64_t durationNs);
+MNN_PUBLIC size_t getLLMProfileBuckets(LLMProfileBucket* buckets, size_t capacity);
+
+} // namespace MNN
+
+#endif // MNN_LLM_PROFILE_H
