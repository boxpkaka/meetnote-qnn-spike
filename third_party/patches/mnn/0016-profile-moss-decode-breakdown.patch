+
+double nsToMs(uint64_t durationNs) {
+    return static_cast<double>(durationNs) / 1000000.0;
+}
+
+void writeDecodeProfile(std::ostream& output, const std::vector<MNN::LLMProfileBucket>& buckets,
+                        double decodeMs) {
+    double accountedMs = 0.0;
+    output << "{\"history_buckets\":[";
+    for (size_t index = 0; index < buckets.size(); ++index) {
+        const auto& bucket = buckets[index];
+        const double cpuAttentionMs = nsToMs(bucket.cpuAttentionNs);
+        const double kvUpdateMs = nsToMs(bucket.cpuAttentionKVUpdateNs);
+        const double qnnInputCopyMs = nsToMs(bucket.qnnInputCopyNs);
+        const double qnnExecuteSyncMs = nsToMs(bucket.qnnExecuteSyncNs);
+        const double qnnOutputCopyMs = nsToMs(bucket.qnnOutputCopyNs);
+        const double qnnStateUpdateMs = nsToMs(bucket.qnnStateUpdateNs);
+        accountedMs += cpuAttentionMs + qnnInputCopyMs + qnnExecuteSyncMs + qnnOutputCopyMs + qnnStateUpdateMs;
+        if (index > 0) output << ',';
+        output << "{\"history_begin\":" << bucket.historyBegin
+               << ",\"history_end\":" << bucket.historyEnd
+               << ",\"cpu_attention_calls\":" << bucket.cpuAttentionCalls
+               << ",\"cpu_attention_ms\":" << cpuAttentionMs
+               << ",\"cpu_attention_kv_update_ms\":" << kvUpdateMs
+               << ",\"cpu_attention_compute_ms\":" << (cpuAttentionMs - kvUpdateMs)
+               << ",\"qnn_graph_calls\":" << bucket.qnnGraphCalls
+               << ",\"qnn_input_copy_ms\":" << qnnInputCopyMs
+               << ",\"qnn_execute_sync_ms\":" << qnnExecuteSyncMs
+               << ",\"qnn_output_copy_ms\":" << qnnOutputCopyMs
+               << ",\"qnn_state_update_ms\":" << qnnStateUpdateMs << '}';
+    }
+    output << "],\"accounted_ms\":" << accountedMs
+           << ",\"unaccounted_ms\":" << (decodeMs - accountedMs) << '}';
+}
