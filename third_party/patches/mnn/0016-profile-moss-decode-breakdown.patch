 namespace MNN {
 
+namespace {
+
+constexpr size_t kProfileBucketCount = 5;
+constexpr int kProfileBucketWidth = 2048;
+
+struct AtomicLLMProfileBucket {
+    std::atomic<uint64_t> cpuAttentionCalls{0};
+    std::atomic<uint64_t> cpuAttentionNs{0};
+    std::atomic<uint64_t> cpuAttentionKVUpdateNs{0};
+    std::atomic<uint64_t> qnnGraphCalls{0};
+    std::atomic<uint64_t> qnnInputCopyNs{0};
+    std::atomic<uint64_t> qnnExecuteSyncNs{0};
+    std::atomic<uint64_t> qnnOutputCopyNs{0};
+    std::atomic<uint64_t> qnnStateUpdateNs{0};
+};
+
+std::atomic<bool> gLLMProfileEnabled{false};
+std::array<AtomicLLMProfileBucket, kProfileBucketCount> gLLMProfileBuckets;
+
+size_t profileBucketIndex(int historyLength) {
+    if (historyLength <= 0) {
+        return 0;
+    }
+    const size_t index = static_cast<size_t>(historyLength / kProfileBucketWidth);
+    return index < kProfileBucketCount ? index : kProfileBucketCount - 1;
+}
+
+uint64_t elapsedNs(std::chrono::steady_clock::time_point started) {
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - started).count());
+}
+
+class CPUAttentionProfileScope {
+public:
+    explicit CPUAttentionProfileScope(bool decode)
+        : mEnabled(decode && isLLMProfileEnabled()),
+          mStarted(mEnabled ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point()) {
+    }
+
+    ~CPUAttentionProfileScope() {
+        if (mEnabled && mHistoryLength >= 0) {
+            recordLLMProfile(LLMProfileCategory::CPUAttention, mHistoryLength, elapsedNs(mStarted));
+        }
+    }
+
+    bool enabled() const {
+        return mEnabled;
+    }
+
+    void setHistoryLength(int historyLength) {
+        mHistoryLength = historyLength;
+    }
+
+private:
+    bool mEnabled = false;
+    int mHistoryLength = -1;
+    std::chrono::steady_clock::time_point mStarted;
+};
+
+} // namespace
+
+void setLLMProfileEnabled(bool enabled) {
+    gLLMProfileEnabled.store(enabled, std::memory_order_relaxed);
+}
+
+bool isLLMProfileEnabled() {
+    return gLLMProfileEnabled.load(std::memory_order_relaxed);
+}
+
+void resetLLMProfile() {
+    for (auto& bucket : gLLMProfileBuckets) {
+        bucket.cpuAttentionCalls.store(0, std::memory_order_relaxed);
+        bucket.cpuAttentionNs.store(0, std::memory_order_relaxed);
+        bucket.cpuAttentionKVUpdateNs.store(0, std::memory_order_relaxed);
+        bucket.qnnGraphCalls.store(0, std::memory_order_relaxed);
+        bucket.qnnInputCopyNs.store(0, std::memory_order_relaxed);
+        bucket.qnnExecuteSyncNs.store(0, std::memory_order_relaxed);
+        bucket.qnnOutputCopyNs.store(0, std::memory_order_relaxed);
+        bucket.qnnStateUpdateNs.store(0, std::memory_order_relaxed);
+    }
+}
+
+void recordLLMProfile(LLMProfileCategory category, int historyLength, uint64_t durationNs) {
+    if (!isLLMProfileEnabled()) {
+        return;
+    }
+    auto& bucket = gLLMProfileBuckets[profileBucketIndex(historyLength)];
+    switch (category) {
+        case LLMProfileCategory::CPUAttention:
+            bucket.cpuAttentionCalls.fetch_add(1, std::memory_order_relaxed);
+            bucket.cpuAttentionNs.fetch_add(durationNs, std::memory_order_relaxed);
+            break;
+        case LLMProfileCategory::CPUAttentionKVUpdate:
+            bucket.cpuAttentionKVUpdateNs.fetch_add(durationNs, std::memory_order_relaxed);
+            break;
+        case LLMProfileCategory::QNNInputCopy:
+            bucket.qnnInputCopyNs.fetch_add(durationNs, std::memory_order_relaxed);
+            break;
+        case LLMProfileCategory::QNNExecuteSync:
+            bucket.qnnGraphCalls.fetch_add(1, std::memory_order_relaxed);
+            bucket.qnnExecuteSyncNs.fetch_add(durationNs, std::memory_order_relaxed);
+            break;
+        case LLMProfileCategory::QNNOutputCopy:
+            bucket.qnnOutputCopyNs.fetch_add(durationNs, std::memory_order_relaxed);
+            break;
+        case LLMProfileCategory::QNNStateUpdate:
+            bucket.qnnStateUpdateNs.fetch_add(durationNs, std::memory_order_relaxed);
+            break;
+    }
+}
+
+size_t getLLMProfileBuckets(LLMProfileBucket* buckets, size_t capacity) {
+    if (buckets == nullptr || capacity == 0) {
+        return kProfileBucketCount;
+    }
+    const size_t count = capacity < kProfileBucketCount ? capacity : kProfileBucketCount;
+    for (size_t i = 0; i < count; ++i) {
+        const auto& source = gLLMProfileBuckets[i];
+        auto& destination = buckets[i];
+        destination.historyBegin = static_cast<int32_t>(i * kProfileBucketWidth);
+        destination.historyEnd = static_cast<int32_t>((i + 1) * kProfileBucketWidth);
+        if (i + 1 == kProfileBucketCount) {
+            destination.historyEnd = 10240;
+        }
+        destination.cpuAttentionCalls = source.cpuAttentionCalls.load(std::memory_order_relaxed);
+        destination.cpuAttentionNs = source.cpuAttentionNs.load(std::memory_order_relaxed);
+        destination.cpuAttentionKVUpdateNs = source.cpuAttentionKVUpdateNs.load(std::memory_order_relaxed);
+        destination.qnnGraphCalls = source.qnnGraphCalls.load(std::memory_order_relaxed);
+        destination.qnnInputCopyNs = source.qnnInputCopyNs.load(std::memory_order_relaxed);
+        destination.qnnExecuteSyncNs = source.qnnExecuteSyncNs.load(std::memory_order_relaxed);
+        destination.qnnOutputCopyNs = source.qnnOutputCopyNs.load(std::memory_order_relaxed);
+        destination.qnnStateUpdateNs = source.qnnStateUpdateNs.load(std::memory_order_relaxed);
+    }
+    return kProfileBucketCount;
+}
