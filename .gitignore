# This workspace already contains large experimental state. Keep the repository
# allowlisted so SDKs, model weights, generated graphs, logs, and caches cannot
# be added accidentally.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/pyproject.toml
!/requirements-export.lock
!/requirements-export-cpu.lock
!/requirements-host.lock
!/requirements-dev.lock
!/docs/
!/experiments/
!/fixtures/
!/releases/
!/tools/
!/third_party/

/third_party/*
!/third_party/patches/

**/__pycache__/
**/*.py[cod]
**/*.o
**/*.so
**/*.a
**/*.bin
**/*.mnn
**/*.weight
**/*.f32
**/*.log
**/*.strace
**/.DS_Store
